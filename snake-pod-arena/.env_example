# Snake Pod Arena configuration.
#
# This is the ONLY place to configure the game (the browser can just start/stop/restart it).
# After editing, run `make deploy`: the arena pod is replaced automatically
# and comes back up *stopped*. Press Start in the browser to launch the snake pods.

# Number of snake pods created on Start (1-30)
SNAKE_COUNT=12

# Maximum number of food items (soldiers/tanks) on the board at once (1-50)
MAX_FOOD=6

# A snake pod crashes on purpose (status Error) after this many deaths (1-20)
MAX_DEATHS=5

# Game speed: milliseconds per tick, lower = faster (50-2000)
TICK_MS=100

# After Start: begin when all pods are ready, or after this many seconds with the pods that are ready (1-600)
START_TIMEOUT_SECONDS=30
